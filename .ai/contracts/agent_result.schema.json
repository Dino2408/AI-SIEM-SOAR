{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status", "summary", "artifacts", "tool_calls", "handoff"],
  "properties": {
    "status": {"enum": ["SUCCESS", "FAILURE", "BLOCKED"]},
    "summary": {"type": "string"},
    "artifacts": {"type": "array", "items": {
      "type": "object",
      "required": ["path", "operation", "content"],
      "properties": {"path": {"type": "string"}, "operation": {"const": "write"}, "content": {"type": "string"}},
      "additionalProperties": false
    }},
    "tool_calls": {"type": "array", "items": {
      "type": "object",
      "required": ["tool", "args"],
      "properties": {"tool": {"type": "string"}, "args": {"type": "object"}},
      "additionalProperties": false
    }},
    "handoff": {"type": "object", "required": ["next_agent", "notes"],
      "properties": {"next_agent": {"type": ["string","null"]}, "notes": {"type": "string"}},
      "additionalProperties": false}
  },
  "additionalProperties": false
}